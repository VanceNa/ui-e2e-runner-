{
  "name": "ui-e2e-runner",
  "version": "0.1.0",
  "description": "通用前端 UI + API 自动化测试最小实现",
  "type": "module",
  "author": "Front-End team",
  "scripts": {
    "test:ui": "playwright test",
    "test:ui:admin": "cross-env E2E_PROJECT=admin playwright test",
    "test:ui:admin:authflow": "cross-env E2E_PROJECT=admin playwright test tests/integration/admin.auth-flow.spec.ts --project=chromium-desktop",
    "test:ui:admin:scenario": "cross-env E2E_PROJECT=admin playwright test tests/integration/admin.arrange-act-assert.spec.ts --project=chromium-desktop",
    "test:ui:admin:onboarding": "cross-env E2E_PROJECT=admin playwright test tests/integration/admin.user-role-onboarding.spec.ts --project=chromium-desktop",
    "test:ui:admin:onboarding:headed": "cross-env E2E_PROJECT=admin playwright test tests/integration/admin.user-role-onboarding.spec.ts --project=chromium-desktop --headed --workers=1",
    "test:ui:admin:onboarding:debug": "cross-env E2E_PROJECT=admin playwright test tests/integration/admin.user-role-onboarding.spec.ts --project=chromium-desktop --debug --workers=1",
    "test:ui:admin:onboarding:slow": "cross-env E2E_PROJECT=admin E2E_SLOWMO_MS=800 playwright test tests/integration/admin.user-role-onboarding.spec.ts --project=chromium-desktop --headed --workers=1",
    "test:ui:admin:onboarding:observe": "cross-env E2E_PROJECT=admin E2E_SLOWMO_MS=800 E2E_PAUSE_ON_END=1 playwright test tests/integration/admin.user-role-onboarding.spec.ts --project=chromium-desktop --headed --workers=1 --reporter=list",
    "test:ui:member": "cross-env E2E_PROJECT=member playwright test",
    "test:ui:marketing": "cross-env E2E_PROJECT=marketing playwright test",
    "test:ui:mobile": "cross-env E2E_ENABLE_MOBILE=1 playwright test",
    "test:ui:mobile:strict": "cross-env E2E_ENABLE_MOBILE=1 E2E_MOBILE_STRICT=1 playwright test --project=chromium-mobile",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:ui:ui": "playwright test --ui",
    "test:ui:report": "playwright show-report",
    "test:ui:install": "playwright install"
  },
  "devDependencies": {
    "@lonely9/eslint-config-team": "^1.3.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.5.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
